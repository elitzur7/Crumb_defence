{
  "name": "crumb-defense",
  "version": "0.7.3",
  "private": true,
  "description": "Crumb Defense - cute ant tower defense (offline prototype)",
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "test": "node --test tests/logic.test.js tests/regress.test.js tests/v020.test.js tests/v030.test.js tests/v040.test.js tests/v050.test.js tests/v060.test.js tests/v061.test.js tests/v062.test.js tests/v070.test.js tests/v072.test.js tests/v073.test.js",
    "test:ui": "node tools/regress-ui.mjs",
    "tuning:csv": "node ../tuning/json2csv.mjs",
    "tuning:json": "node ../tuning/csv2json.mjs",
    "winrates": "node tools/winrates.mjs",
    "sim": "node tools/sim-levels.mjs",
    "screens": "node tools/screens.mjs",
    "towers": "node tools/towers.mjs",
    "maps": "node tools/maps.mjs",
    "gallery": "node tools/towers-gallery.mjs",
    "shots:v040": "node tools/shots-v040.mjs",
    "shots:v050": "node tools/shots-v050.mjs",
    "antsizes": "node tools/ant-sizes.mjs --png /workspace/ant-td/screens/v0.4.0/ant-sizes.png",
    "waves": "node tools/wave-report.mjs",
    "serve": "node tools/serve.mjs www",
    "android:sync": "npx cap sync android && node tools/android-postsync.mjs",
    "ranges": "node tools/range-shots.mjs && python3 tools/range-measure.py"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "puppeteer-core": "^24.43.1"
  }
}